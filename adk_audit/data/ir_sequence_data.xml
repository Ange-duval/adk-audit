<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_audit_session_metier" model="ir.sequence">
        <field name="name">Audit Métier</field>
        <field name="code">audit.session.metier</field>
        <field name="prefix">AUD-MET-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_audit_session_qhse" model="ir.sequence">
        <field name="name">Audit QHSE</field>
        <field name="code">audit.session.qhse</field>
        <field name="prefix">AUD-QHSE-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
