<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_audit_action_list" model="ir.ui.view">
        <field name="name">audit.action.list</field>
        <field name="model">audit.action</field>
        <field name="arch" type="xml">
            <list string="Actions / Mesures" decoration-danger="is_late" editable="bottom">
                <field name="name"/>
                <field name="session_id"/>
                <field name="anomaly_id"/>
                <field name="responsible_id"/>
                <field name="deadline"/>
                <field name="state"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'in_progress'"/>
                <field name="is_late" widget="boolean_toggle" optional="show"/>
                <button name="action_mark_done" type="object" string="Clôturer"
                        icon="fa-check" invisible="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_audit_action_form" model="ir.ui.view">
        <field name="name">audit.action.form</field>
        <field name="model">audit.action</field>
        <field name="arch" type="xml">
            <form string="Action / Mesure">
                <header>
                    <button name="action_mark_done" type="object" string="Marquer comme réalisée"
                            class="btn-primary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="todo,in_progress,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="session_id"/>
                            <field name="anomaly_id" domain="[('session_id', '=', session_id)]"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="deadline"/>
                            <field name="date_done"/>
                            <field name="is_late"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_audit_action_search" model="ir.ui.view">
        <field name="name">audit.action.search</field>
        <field name="model">audit.action</field>
        <field name="arch" type="xml">
            <search string="Rechercher Actions">
                <field name="name"/>
                <field name="responsible_id"/>
                <field name="session_id"/>
                <filter string="En retard" name="late" domain="[('is_late', '=', True)]"/>
                <filter string="A faire" name="todo" domain="[('state', '=', 'todo')]"/>
                <filter string="Réalisées" name="done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Responsable" name="group_resp" context="{'group_by': 'responsible_id'}"/>
                    <filter string="Audit" name="group_session" context="{'group_by': 'session_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_audit_action" model="ir.actions.act_window">
        <field name="name">Actions / Mesures</field>
        <field name="res_model">audit.action</field>
        <field name="view_mode">list,form,graph,pivot</field>
    </record>

</odoo>
