<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Réutilise le modèle standard hr.department : on expose simplement une
         action dédiée dans ADK-AUDIT pour créer/gérer les Services sans
         devoir ouvrir l'application RH. Les vues natives (name, manager_id,
         member_ids...) sont utilisées telles quelles. -->
    <record id="action_audit_department" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Créez un service (ex: Finance, RH, Production) à auditer</p></field>
    </record>

</odoo>
