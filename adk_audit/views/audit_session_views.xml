<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_audit_session_list" model="ir.ui.view">
        <field name="name">audit.session.list</field>
        <field name="model">audit.session</field>
        <field name="arch" type="xml">
            <list string="Audits" decoration-muted="state == 'draft'" decoration-success="state == 'closed'">
                <field name="name"/>
                <field name="title"/>
                <field name="audit_type" widget="badge"/>
                <field name="department_id"/>
                <field name="location_id"/>
                <field name="date"/>
                <field name="conformity_rate" widget="progressbar"/>
                <field name="anomaly_open_count" string="Anom. ouvertes"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'closed'"
                       decoration-info="state == 'in_progress'"/>
            </list>
        </field>
    </record>

    <record id="view_audit_session_kanban" model="ir.ui.view">
        <field name="name">audit.session.kanban</field>
        <field name="model">audit.session</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="title"/>
                <field name="state"/>
                <field name="conformity_rate"/>
                <field name="anomaly_open_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <strong><field name="name"/> - <field name="title"/></strong>
                            <div>Conformité : <field name="conformity_rate" widget="percentage"/></div>
                            <div>Anomalies ouvertes : <field name="anomaly_open_count"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_audit_session_form" model="ir.ui.view">
        <field name="name">audit.session.form</field>
        <field name="model">audit.session</field>
        <field name="arch" type="xml">
            <form string="Fiche Audit">
                <header>
                    <button name="action_start" type="object" string="Démarrer" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Clôturer" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_reset_draft" type="object" string="Repasser en brouillon"
                            invisible="state == 'draft'"/>
                    <button name="action_print_report" type="object" string="Générer Rapport PDF"
                            class="btn-secondary" icon="fa-file-pdf-o"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_anomalies" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="anomaly_count" widget="statinfo" string="Anomalies"/>
                        </button>
                        <button name="action_view_actions" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="action_count" widget="statinfo" string="Actions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <field name="title" placeholder="Titre de l'audit..."/>
                    </div>
                    <group>
                        <group>
                            <field name="audit_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="company_audited_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="department_id"/>
                            <field name="location_id" invisible="audit_type != 'qhse'"/>
                        </group>
                        <group>
                            <field name="auditor_ids" widget="many2many_tags"/>
                            <field name="date"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="conformity_rate" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Points d'audit / Checklist">
                            <button name="action_load_checklist" type="object"
                                    string="Charger la Checklist Type" class="btn-secondary mb-2"
                                    icon="fa-download"/>
                            <field name="line_ids">
                                <list editable="bottom" decoration-danger="state == 'non_conforme'"
                                      decoration-success="state == 'conforme'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="template_id" optional="hide"/>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="anomaly_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Anomalies">
                            <field name="anomaly_ids" context="{'default_session_id': id}">
                                <list editable="bottom" decoration-danger="severity == 'critical'">
                                    <field name="name"/>
                                    <field name="line_id" domain="[('session_id', '=', parent.id)]"/>
                                    <field name="severity"/>
                                    <field name="state"/>
                                    <field name="responsible_id"/>
                                    <field name="date_detected"/>
                                </list>
                            </field>
                        </page>
                        <page string="Actions / Mesures correctives">
                            <field name="action_ids" context="{'default_session_id': id}">
                                <list editable="bottom" decoration-danger="is_late">
                                    <field name="name"/>
                                    <field name="anomaly_id" domain="[('session_id', '=', parent.id)]"/>
                                    <field name="responsible_id"/>
                                    <field name="deadline"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Synthèse / Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_audit_session_search" model="ir.ui.view">
        <field name="name">audit.session.search</field>
        <field name="model">audit.session</field>
        <field name="arch" type="xml">
            <search string="Rechercher Audits">
                <field name="name"/>
                <field name="title"/>
                <field name="department_id"/>
                <field name="location_id"/>
                <field name="auditor_ids"/>
                <filter string="Brouillon" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="En cours" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Clôturé" name="closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="Ce mois-ci" name="this_month"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Type d'audit" name="group_type" context="{'group_by': 'audit_type'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Service" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Mois" name="group_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_audit_session_graph" model="ir.ui.view">
        <field name="name">audit.session.graph</field>
        <field name="model">audit.session</field>
        <field name="arch" type="xml">
            <graph string="Taux de conformité" type="bar">
                <field name="department_id"/>
                <field name="conformity_rate" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_audit_session_pivot" model="ir.ui.view">
        <field name="name">audit.session.pivot</field>
        <field name="model">audit.session</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des Audits">
                <field name="department_id" type="row"/>
                <field name="audit_type" type="col"/>
                <field name="conformity_rate" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Action générique (admin) -->
    <record id="action_audit_session_all" model="ir.actions.act_window">
        <field name="name">Tous les Audits</field>
        <field name="res_model">audit.session</field>
        <field name="view_mode">list,kanban,form,graph,pivot</field>
        <field name="context">{}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Créez votre première fiche d'audit</p></field>
    </record>

    <!-- Action Audit Métier -->
    <record id="action_audit_session_metier" model="ir.actions.act_window">
        <field name="name">Audits Métier</field>
        <field name="res_model">audit.session</field>
        <field name="view_mode">list,kanban,form,graph,pivot</field>
        <field name="domain">[('audit_type', '=', 'metier')]</field>
        <field name="context">{'default_audit_type': 'metier', 'search_default_in_progress': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Créez un nouvel audit Métier (Finance / Gestion)</p></field>
    </record>

    <!-- Action Audit QHSE -->
    <record id="action_audit_session_qhse" model="ir.actions.act_window">
        <field name="name">Audits QHSE</field>
        <field name="res_model">audit.session</field>
        <field name="view_mode">list,kanban,form,graph,pivot</field>
        <field name="domain">[('audit_type', '=', 'qhse')]</field>
        <field name="context">{'default_audit_type': 'qhse', 'search_default_in_progress': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Créez un nouvel audit QHSE</p></field>
    </record>

</odoo>
